#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "bullet"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "bullet" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </bullet/Physics/rotor_0_joint>,
        </bullet/Physics/rotor_1_joint>,
        </bullet/Physics/rotor_2_joint>,
        </bullet/Physics/rotor_3_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </bullet/Geometry/base_link>,
        </bullet/Geometry/base_link/rotor_0>,
        </bullet/Geometry/base_link/rotor_1>,
        </bullet/Geometry/base_link/rotor_2>,
        </bullet/Geometry/base_link/rotor_3>,
    ]
    token isaac:robotType = "Aerial"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "rotor_0" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rotor_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rotor_2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rotor_3" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "rotor_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rotor_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rotor_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rotor_3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

