#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "bullet"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "bullet"
{
    over "Physics"
    {
        over "rotor_0_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rotor_1_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rotor_2_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rotor_3_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "rotor_0_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </bullet/Physics/rotor_0_joint>
        }

        def MjcActuator "rotor_1_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </bullet/Physics/rotor_1_joint>
        }

        def MjcActuator "rotor_2_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </bullet/Physics/rotor_2_joint>
        }

        def MjcActuator "rotor_3_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [0.00017453292093705386, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </bullet/Physics/rotor_3_joint>
        }
    }
}

