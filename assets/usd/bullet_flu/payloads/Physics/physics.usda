            point3f physics:centerOfMass = (-0.2871, 0, 0)
            float3 physics:diagonalInertia = (0.0496, 0.1031, 0.1037)
            float physics:mass = 3.3626
            quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)

            over "rotor_0" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
