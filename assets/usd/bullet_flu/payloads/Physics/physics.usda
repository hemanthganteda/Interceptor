    over "Physics"
    {
        def PhysicsRevoluteJoint "rotor_0_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.00017453292
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </bullet/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </bullet/Geometry/base_link/rotor_0>
            point3f physics:localPos0 = (-0.5482221, 0.13773277, 0.13773282)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0, 0, 0.70710677, -0.70710677)
            quatf physics:localRot1 = (0, 0, -1, 0)
        }

