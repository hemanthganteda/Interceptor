#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "bullet"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "bullet"
{
    over "Physics"
    {
        over "rotor_0_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rotor_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rotor_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rotor_3_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

